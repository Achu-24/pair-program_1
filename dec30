def maxx(nums,k):
    left,max_len,zeros=0,0,0
    for right in range(len(nums)):
        if nums[right]==0:
        while zeros>k:
            if nums[left]==0:
                zeros-=1
            left+=1
        max_len=max(max_len,right-left+1)
    return max_len

nums=list(map(int,input().split()))
k=int(input())
o=maxx(nums,k)
print(o)

